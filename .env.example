# Bun loads .env automatically

# Config file path, defaults to ./config.toml
# ROBIN_CONFIG=config.toml

# Telegram: api_id / api_hash from https://my.telegram.org, bot token from @BotFather.
# Turn the bot's privacy mode off in @BotFather (/setprivacy -> Disable), then re-add it to each group
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
